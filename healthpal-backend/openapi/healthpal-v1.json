{
  "openapi": "3.0.1",
  "info": {
    "title": "HealthPal API",
    "description": "Authentication, profile, health sync, dashboard and history APIs.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/assessments/latest": {
      "get": {
        "tags": [
          "Assessments"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FatigueAssessmentDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPairDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/change-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/account": {
      "delete": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/dashboard/today": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "parameters": [
          {
            "name": "localDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "timezone",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardTodayDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exercises": {
      "get": {
        "tags": [
          "Exercises"
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExerciseSessionDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/history": {
      "get": {
        "tags": [
          "History"
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DailyHealthSummaryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "tags": [
          "Profile"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Profile"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile/preferences": {
      "put": {
        "tags": [
          "Profile"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePreferencesRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePreferencesRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePreferencesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sync/batches": {
      "post": {
        "tags": [
          "Sync"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncBatchDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncBatchDto"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/SyncBatchDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncBatchResultDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssessmentCreatedBy": {
        "enum": [
          "foreground",
          "background"
        ],
        "type": "string"
      },
      "AuthSessionDto": {
        "required": [
          "tokens",
          "user"
        ],
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenPairDto"
          }
        },
        "additionalProperties": false
      },
      "AuthUserDto": {
        "required": [
          "email",
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DailyHealthSummaryDto": {
        "type": "object",
        "properties": {
          "localDate": {
            "type": "string",
            "format": "date"
          },
          "timezone": {
            "type": "string",
            "nullable": true
          },
          "sleepMinutes": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "steps": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "averageHeartRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "minHeartRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxHeartRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "restingHeartRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "activeCalories": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "exerciseCount": {
            "type": "integer",
            "format": "int32"
          },
          "exerciseDurationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "coverageFlags": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "nullable": true
          },
          "fatigue": {
            "$ref": "#/components/schemas/FatigueDailyValueDto"
          }
        },
        "additionalProperties": false
      },
      "DashboardTodayDto": {
        "type": "object",
        "properties": {
          "localDate": {
            "type": "string",
            "format": "date"
          },
          "summary": {
            "$ref": "#/components/schemas/DailyHealthSummaryDto"
          },
          "latestAssessment": {
            "$ref": "#/components/schemas/FatigueAssessmentDto"
          },
          "latestSampleAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "serverSyncedAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DeleteAccountRequest": {
        "required": [
          "password"
        ],
        "type": "object",
        "properties": {
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ExerciseSessionDto": {
        "type": "object",
        "properties": {
          "externalRecordId": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "startUtc": {
            "type": "string",
            "format": "date-time"
          },
          "endUtc": {
            "type": "string",
            "format": "date-time"
          },
          "zoneOffsetMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "calories": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "sourceId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FatigueAssessmentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "evaluatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "localDate": {
            "type": "string",
            "format": "date"
          },
          "modelVersion": {
            "type": "string",
            "nullable": true
          },
          "baseProbability": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "calibratedProbability": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "threshold": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "$ref": "#/components/schemas/FatigueAssessmentStatus"
          },
          "coverageHours": {
            "type": "integer",
            "format": "int32"
          },
          "latestSampleAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "dataFreshnessMinutes": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "missingReasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "featureVectorHash": {
            "type": "string",
            "nullable": true
          },
          "createdBy": {
            "$ref": "#/components/schemas/AssessmentCreatedBy"
          },
          "featureVectorJson": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FatigueAssessmentStatus": {
        "enum": [
          "signalDetected",
          "noClearSignal",
          "insufficientData",
          "suppressedDuringExercise"
        ],
        "type": "string"
      },
      "FatigueDailyValueDto": {
        "type": "object",
        "properties": {
          "probability": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/FatigueAssessmentStatus"
          },
          "evaluatedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "HourlyHealthBinDto": {
        "type": "object",
        "properties": {
          "hourUtc": {
            "type": "string",
            "format": "date-time"
          },
          "zoneOffsetMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "hrMean": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "hrMin": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "hrMax": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "hrSampleCount": {
            "type": "integer",
            "format": "int32"
          },
          "steps": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "activeCalories": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "sourceId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          },
          "deviceId": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LogoutRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": {}
      },
      "ProfileDto": {
        "required": [
          "displayName",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "nullable": true
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "nullable": true
          },
          "heightCm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "weightKg": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "goal": {
            "type": "string",
            "nullable": true
          },
          "dailyStepGoal": {
            "type": "integer",
            "format": "int32"
          },
          "timezone": {
            "type": "string",
            "nullable": true
          },
          "preferredSourceId": {
            "type": "string",
            "nullable": true
          },
          "rowVersion": {
            "type": "string",
            "nullable": true
          },
          "experimentalFatigueConsent": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterRequest": {
        "required": [
          "email",
          "name",
          "password"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "deviceId": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ReplacementWindowDto": {
        "type": "object",
        "properties": {
          "startUtc": {
            "type": "string",
            "format": "date-time"
          },
          "endUtcExclusive": {
            "type": "string",
            "format": "date-time"
          },
          "localDateStart": {
            "type": "string",
            "format": "date"
          },
          "localDateEndExclusive": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      },
      "SyncBatchDto": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "format": "int32"
          },
          "deviceId": {
            "type": "string",
            "nullable": true
          },
          "idempotencyKey": {
            "type": "string",
            "nullable": true
          },
          "generatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "hourlyBins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HourlyHealthBinDto"
            },
            "nullable": true
          },
          "dailySummaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyHealthSummaryDto"
            },
            "nullable": true
          },
          "exerciseSessions": {
